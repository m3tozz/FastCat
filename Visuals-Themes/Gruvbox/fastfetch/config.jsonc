// ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "iterm",
    "source": "logo.png",
    "height": 20,
    "width": 30,
    "padding": {
      "top": 4,
      "left": 0,
      "right": 0
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#fabd2f", 
        "at": "#a89984",   
        "host": "#b8bb26"  
      }
    },
    "separator",
    {
      "type": "os",
      "key": "  OS     ",
      "keyColor": "#fb4934" 
    },
    {
      "type": "kernel",
      "key": "  Kernel ",
      "keyColor": "#fe8019" 
    },
    {
      "type": "uptime",
      "key": "󰅐  Uptime ",
      "keyColor": "#fabd2f" 
    },
    {
      "type": "custom",
      "key": "  Age    ",
      "keyColor": "#b8bb26",
      "format": "22" 
    },
    {
      "type": "packages",
      "key": "󰏖  Pkgs   ",
      "keyColor": "#b8bb26" 
    },
    "break",
    {
      "type": "de",
      "key": "󰧨  DE     ",
      "keyColor": "#8ec07c" 
    },
    {
      "type": "wm",
      "key": "󱂬  WM     ",
      "keyColor": "#83a598" 
    },
    {
      "type": "terminal",
      "key": "  Term   ",
      "keyColor": "#d3869b" 
    },
    "break",
    {
      "type": "cpu",
      "key": "  CPU    ",
      "keyColor": "#fb4934",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "󰢮  GPU    ",
      "keyColor": "#fe8019" 
    },
    {
      "type": "memory",
      "key": "  RAM    ",
      "keyColor": "#fabd2f" 
    },
    "break",
    {
      "type": "command",
      "key": "󰖐  Weather",
      "keyColor": "#8ec07c",
      "text": "curl -s 'https://api.openweathermap.org/data/2.5/weather?id=YOUR_CITY_ID&appid=YOUR_API_KEY&units=metric' | jq -r '\"\\(.main.temp|round)°C, \\(.weather[0].description)\"'"
    },
    {
      "type": "player",
      "key": "󰎆  Player ",
      "keyColor": "#83a598"
    },
    {
      "type": "media",
      "key": "󰝚  Media  ",
      "keyColor": "#d3869b",
      "format": "{2}"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[31m \u001b[33m \u001b[32m \u001b[36m \u001b[34m \u001b[35m \u001b[37m"
    }
  ]
}
